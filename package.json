{
  "name": "figma-design-linter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:ui && npm run build:plugin",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "watch": "concurrently \"npm run build:plugin -- --watch\" \"npm run build:ui -- --watch\""
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.106.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  }
}
